{
  "samples": {
    "normalize": "اين يك متن نمونه است كه با صفحه‌كليد عربي نوشته شده‌ است ؛ اعداد ١٢٣ و ۴۵۶ و 789 ...  مي خواهم آن را درست كنم ؟",
    "inspect": "سلام‌ دنیا! يك كتاب ‏Kurdî: ئەز کوردم 123",
    "translit": {
      "sorani": "زمانی کوردی زمانێکی جوانە",
      "persian": "زبان‌های ایرانی خانواده‌ای بزرگ هستند"
    }
  },
  "normalize": [
    {
      "id": "yeh",
      "label": "Arabic ي and ى → Persian ی",
      "default": true,
      "rules": [
        [
          "[يى]",
          "g",
          "ی"
        ]
      ]
    },
    {
      "id": "kaf",
      "label": "Arabic ك → Persian ک",
      "default": true,
      "rules": [
        [
          "ك",
          "g",
          "ک"
        ]
      ]
    },
    {
      "id": "digits_fa",
      "label": "Arabic-Indic digits ٠–٩ → Persian ۰–۹",
      "default": true,
      "rules": [
        [
          "٠",
          "g",
          "۰"
        ],
        [
          "١",
          "g",
          "۱"
        ],
        [
          "٢",
          "g",
          "۲"
        ],
        [
          "٣",
          "g",
          "۳"
        ],
        [
          "٤",
          "g",
          "۴"
        ],
        [
          "٥",
          "g",
          "۵"
        ],
        [
          "٦",
          "g",
          "۶"
        ],
        [
          "٧",
          "g",
          "۷"
        ],
        [
          "٨",
          "g",
          "۸"
        ],
        [
          "٩",
          "g",
          "۹"
        ]
      ]
    },
    {
      "id": "digits_latin",
      "label": "All digits → Latin 0–9",
      "default": false,
      "rules": [
        [
          "[۰٠]",
          "g",
          "0"
        ],
        [
          "[۱١]",
          "g",
          "1"
        ],
        [
          "[۲٢]",
          "g",
          "2"
        ],
        [
          "[۳٣]",
          "g",
          "3"
        ],
        [
          "[۴٤]",
          "g",
          "4"
        ],
        [
          "[۵٥]",
          "g",
          "5"
        ],
        [
          "[۶٦]",
          "g",
          "6"
        ],
        [
          "[۷٧]",
          "g",
          "7"
        ],
        [
          "[۸٨]",
          "g",
          "8"
        ],
        [
          "[۹٩]",
          "g",
          "9"
        ]
      ]
    },
    {
      "id": "tatweel",
      "label": "Remove tatweel (kashida) ـ",
      "default": true,
      "rules": [
        [
          "ـ",
          "g",
          ""
        ]
      ]
    },
    {
      "id": "diacritics",
      "label": "Remove short-vowel marks (harakat)",
      "default": false,
      "rules": [
        [
          "[ً-ٰٟ]",
          "g",
          ""
        ]
      ]
    },
    {
      "id": "bidi",
      "label": "Remove invisible direction marks and BOM",
      "default": true,
      "rules": [
        [
          "[‎‏‪-‮⁦-⁩﻿­]",
          "g",
          ""
        ]
      ]
    },
    {
      "id": "zwnj",
      "label": "Tidy ZWNJ (no doubles, none next to spaces)",
      "default": true,
      "rules": [
        [
          "‌{2,}",
          "g",
          "‌"
        ],
        [
          "‌(?=\\s)|(?<=\\s)‌",
          "g",
          ""
        ],
        [
          "^‌|‌$",
          "gm",
          ""
        ]
      ]
    },
    {
      "id": "mi",
      "label": "Join می / نمی prefix with ZWNJ",
      "default": true,
      "rules": [
        [
          "(^|[\\s‌])(ن?می) (?=[؀-ۿ])",
          "g",
          "$1$2‌"
        ]
      ]
    },
    {
      "id": "punct",
      "label": "Persian punctuation ، ؛ ؟ after Persian words",
      "default": true,
      "rules": [
        [
          "(?<=[؀-ۿ]\\s?),",
          "g",
          "،"
        ],
        [
          "(?<=[؀-ۿ]\\s?);",
          "g",
          "؛"
        ],
        [
          "(?<=[؀-ۿ]\\s?)\\?",
          "g",
          "؟"
        ]
      ]
    },
    {
      "id": "spaces",
      "label": "Fix spaces around punctuation, collapse repeats",
      "default": true,
      "rules": [
        [
          "[  \t]+",
          "g",
          " "
        ],
        [
          " +([،؛؟.!:)\\]])",
          "g",
          "$1"
        ],
        [
          "([،؛؟!:])(?=[^\\s\\d])",
          "g",
          "$1 "
        ],
        [
          "\\.{3,}",
          "g",
          "…"
        ],
        [
          "^ +| +$",
          "gm",
          ""
        ]
      ]
    },
    {
      "id": "sorani_ae",
      "label": "Sorani: ه + ZWNJ → ە",
      "default": false,
      "rules": [
        [
          "ه‌",
          "g",
          "ە"
        ]
      ]
    }
  ],
  "flags": {
    "064A": {
      "name": "ARABIC LETTER YEH",
      "note": "Arabic Yeh. Persian and Kurdish use ی (U+06CC).",
      "level": "warn"
    },
    "0649": {
      "name": "ARABIC LETTER ALEF MAKSURA",
      "note": "Often typed for ی (U+06CC) in Persian.",
      "level": "warn"
    },
    "0643": {
      "name": "ARABIC LETTER KAF",
      "note": "Arabic Kaf. Persian and Kurdish use ک (U+06A9).",
      "level": "warn"
    },
    "0629": {
      "name": "ARABIC LETTER TEH MARBUTA",
      "note": "Correct in Arabic loanwords; check it is intended.",
      "level": "info"
    },
    "0640": {
      "name": "ARABIC TATWEEL",
      "note": "Decorative stretching; usually removed for NLP.",
      "level": "warn"
    },
    "200C": {
      "name": "ZERO WIDTH NON-JOINER",
      "note": "Half-space. Correct inside words like می‌خواهم; wrong next to a space.",
      "level": "info"
    },
    "200D": {
      "name": "ZERO WIDTH JOINER",
      "note": "Rarely needed in Persian or Kurdish text.",
      "level": "warn"
    },
    "200E": {
      "name": "LEFT-TO-RIGHT MARK",
      "note": "Invisible direction mark.",
      "level": "warn"
    },
    "200F": {
      "name": "RIGHT-TO-LEFT MARK",
      "note": "Invisible direction mark.",
      "level": "warn"
    },
    "202A": {
      "name": "LEFT-TO-RIGHT EMBEDDING",
      "note": "Invisible bidi control.",
      "level": "warn"
    },
    "202B": {
      "name": "RIGHT-TO-LEFT EMBEDDING",
      "note": "Invisible bidi control.",
      "level": "warn"
    },
    "202C": {
      "name": "POP DIRECTIONAL FORMATTING",
      "note": "Invisible bidi control.",
      "level": "warn"
    },
    "202D": {
      "name": "LEFT-TO-RIGHT OVERRIDE",
      "note": "Invisible bidi control.",
      "level": "warn"
    },
    "202E": {
      "name": "RIGHT-TO-LEFT OVERRIDE",
      "note": "Invisible bidi control; can disguise text.",
      "level": "warn"
    },
    "FEFF": {
      "name": "BYTE ORDER MARK",
      "note": "Invisible; often left over from file encodings.",
      "level": "warn"
    },
    "00A0": {
      "name": "NO-BREAK SPACE",
      "note": "Looks like a space but is not one.",
      "level": "info"
    },
    "00AD": {
      "name": "SOFT HYPHEN",
      "note": "Invisible unless a line breaks.",
      "level": "warn"
    },
    "06C0": {
      "name": "ARABIC LETTER HEH WITH YEH ABOVE",
      "note": "Ezafe on final heh; some pipelines expect ه + ٔ instead.",
      "level": "info"
    },
    "0647": {
      "name": "ARABIC LETTER HEH",
      "note": "In Sorani, the vowel e is ە (U+06D5) and h is ھ (U+06BE).",
      "level": "context-sorani"
    }
  },
