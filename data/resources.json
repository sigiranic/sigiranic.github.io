      "code_mixed": [
        {
          "name": "MaskLID",
          "description": "Zero-shot, training-free code-switching LID via iterative masking; tuned on synthetic Persian mixes",
          "languages": "Persian + English/French/Arabic",
          "contribution": "Improves LID in code-switched scenarios using base LIDs like GlotLID",
          "reference": "Kargaran et al., ACL (2024)",
          "notes": "Applicable to Persian-English"
        },
        {
          "name": "PinLID Dataset & Models",
          "description": "Labeled Persian-English code-mixed tweets for sentence/token-level LID; evaluated with SVM, mBERT, XLM-R, ParsBERT, AriaBERT, PersianLLaMA",
          "languages": "Persian-English (Pinglish)",
          "contribution": "Dataset creation + benchmarking; PersianLLaMA strong on code-mixed",
          "reference": "Ghafouri et al., Language Resources and Evaluation (2025)",
          "notes": "High F1-scores; social media focus"
        },
        {
          "name": "BERT-based Sentiment Analysis",
          "description": "BERT embeddings + translation models to learn polarity in code-mixed tweets; outperforms Naïve Bayes/RF",
          "languages": "Persian-English",
          "contribution": "Custom dataset + cross-lingual transfer for sentiment",
          "reference": "Sabri et al., arXiv:2102.12700 / CSICC (2021)",
          "notes": "~3,640 labeled tweets"
        },
        {
          "name": "Pinglish Filter for Morphological Analysis",
          "description": "Normalization to convert Pinglish (Latin Persian-English) to standard Persian script for morphology",
          "languages": "Persian-English (Pinglish)",
          "contribution": "Preprocessing rule-based conversion for tokenization/analysis",
          "reference": "Tavassoli et al., IJCA (2011)",
          "notes": "Early work; adjective-focused"
        },
        {
          "name": "Text Normalization with Pinglish Conversion",
          "description": "Rule-based + learning-based pipeline (e.g., Parsivar) including Pinglish unification for MWE discovery",
          "languages": "Persian-English",
          "contribution": "Improves MWE extraction by ~18% via code-mixed handling",
          "reference": "Marszałek-Kowalewska, RANLP (2021)",
          "notes": "Boosts downstream Persian NLP"
        },
        {
          "name": "Prabhupadavani Dataset",
          "description": "Code-mixed speech translation dataset with audio/transcripts; includes Persian among 25 languages",
          "languages": "Persian + others (English embeddings)",
          "contribution": "Resource for training ASR/translation on code-mixed speech",
          "reference": "Sandhan et al., LaTeCH-CLfL (2022)",
          "notes": "Speech-focused; multilingual CS"
        }
      ]
